{
  "name": "minimax-agent",
  "displayName": "MiniMax Agent",
  "description": "Coding agent for VS Code powered by MiniMax models",
  "version": "0.29.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "minimax",
          "title": "MiniMax",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "minimax": [
        {
          "id": "minimax.chat",
          "name": "Agent",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "minimax.openPanel",
        "title": "Open Panel",
        "category": "MiniMax"
      },
      {
        "command": "minimax.newChat",
        "title": "New Chat",
        "category": "MiniMax"
      },
      {
        "command": "minimax.addApiKey",
        "title": "Add API Key",
        "category": "MiniMax"
      },
      {
        "command": "minimax.setEndpoint",
        "title": "Set Endpoint",
        "category": "MiniMax"
      },
      {
        "command": "minimax.selectModel",
        "title": "Select Model",
        "category": "MiniMax"
      },
      {
        "command": "minimax.setEffort",
        "title": "Set Thinking Effort",
        "category": "MiniMax"
      },
      {
        "command": "minimax.setMode",
        "title": "Set Agent Mode",
        "category": "MiniMax"
      },
      {
        "command": "minimax.undoLastChange",
        "title": "Undo Last File Change",
        "category": "MiniMax"
      },
      {
        "command": "minimax.refreshContext",
        "title": "Refresh Workspace Context",
        "category": "MiniMax"
      },
      {
        "command": "minimax.reindex",
        "title": "Rebuild Project Index",
        "category": "MiniMax"
      },
      {
        "command": "minimax.showUsage",
        "title": "Show Token Spend",
        "category": "MiniMax"
      },
      {
        "command": "minimax.showLogs",
        "title": "Show Logs",
        "category": "MiniMax"
      },
      {
        "command": "minimax.clearApiKey",
        "title": "Clear API Key",
        "category": "MiniMax"
      },
      {
        "command": "minimax.addSelection",
        "title": "Add Selection to Chat",
        "category": "MiniMax"
      },
      {
        "command": "minimax.addFile",
        "title": "Add File to Chat",
        "category": "MiniMax"
      },
      {
        "command": "minimax.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "MiniMax",
        "icon": "$(sparkle)"
      }
    ],
    "configuration": {
      "title": "MiniMax",
      "properties": {
        "minimax.baseUrl": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "global",
            "china"
          ],
          "scope": "application",
          "description": "API region. auto uses the global endpoint."
        },
        "minimax.customBaseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Custom base URL. Overrides the region preset when set. Only https is accepted, the API key goes to this address."
        },
        "minimax.model": {
          "type": "string",
          "default": "MiniMax-M3.1-Flash"
        },
        "minimax.plannerModel": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "MiniMax-M3",
            "MiniMax-M3.1-Flash"
          ],
          "enumDescriptions": [
            "Off: the model of the chat plans and works alone.",
            "MiniMax-M3 writes the plan of the turn, the model of the chat does the work.",
            "MiniMax-M3.1-Flash writes the plan of the turn, the model of the chat does the work."
          ],
          "description": "A planner model writes the plan of every turn in the code mode before the model of the chat works. One more request a turn: turn it on when it helps on your tasks."
        },
        "minimax.effort": {
          "type": "string",
          "default": "max",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "minimax.mode": {
          "type": "string",
          "default": "code",
          "enum": [
            "plan",
            "code"
          ],
          "description": "Agent mode. Plan is read-only, the agent investigates and answers with a plan. Code lets the agent change files and run commands."
        },
        "minimax.thinking": {
          "type": "boolean",
          "default": false,
          "description": "Adaptive thinking for the MiniMax M3 model. M3.1 Flash always thinks and ignores this flag."
        },
        "minimax.maxTokens": {
          "type": "number",
          "default": 32000,
          "minimum": 4096,
          "maximum": 65536,
          "deprecationMessage": "The limit of the answer comes from the model catalog now, this setting is ignored."
        },
        "minimax.collapseTools": {
          "type": "boolean",
          "default": false,
          "description": "Collapses the cards of the actions. The card keeps its title, the details open on a click."
        },
        "minimax.collapseCode": {
          "type": "boolean",
          "default": false,
          "description": "Collapses the code blocks of the answers. The header with the file name stays, the code opens on a click."
        },
        "minimax.showToolSteps": {
          "type": "boolean",
          "default": true,
          "description": "Shows the steps of the tools in the chat. The actions of one step stand under a header, the step is folded by default."
        },
        "minimax.speechLanguage": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "ru",
            "en",
            "uk",
            "de",
            "fr",
            "es",
            "it",
            "pt",
            "pl",
            "tr",
            "ar",
            "zh",
            "yue",
            "ja",
            "ko",
            "th",
            "vi",
            "id",
            "ms",
            "fil"
          ],
          "enumDescriptions": [
            "Auto: the model picks the dominant language",
            "Russian",
            "English",
            "Ukrainian",
            "German",
            "French",
            "Spanish",
            "Italian",
            "Portuguese",
            "Polish",
            "Turkish",
            "Arabic",
            "Chinese",
            "Cantonese",
            "Japanese",
            "Korean",
            "Thai",
            "Vietnamese",
            "Indonesian",
            "Malay",
            "Filipino"
          ],
          "description": "The language of the voice input. A pinned language is more stable on short phrases and jargon."
        },
        "minimax.speechVocabulary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Foreign words of the voice input: names, brands, terms. A bare term (PreSonus) replaces a word that sounds like it, a pair (радиатор=Revelator) replaces the heard word exactly. The recognition writes such words in the letters of the spoken language."
        },
        "minimax.microphone": {
          "type": "string",
          "default": "",
          "description": "The microphone of the voice input, as ffmpeg names it. Empty picks a device named as a microphone."
        },
        "minimax.ffmpegPath": {
          "type": "string",
          "default": "ffmpeg",
          "scope": "application",
          "description": "The ffmpeg that records the voice input. The webview of VS Code has no access to the microphone."
        },
        "minimax.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 10,
          "maximum": 22,
          "description": "The size of the font of the panel in pixels."
        },
        "minimax.historyMaxMessages": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 1000,
          "description": "How many messages the chat keeps before the oldest turns are cut."
        },
        "minimax.contextThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "maximum": 95,
          "description": "The share of the context window the history may take, in percent."
        },
        "minimax.semanticSearch": {
          "type": "boolean",
          "default": false,
          "description": "Adds the semantic layer to the search. The code of the project is sent to MiniMax to build the vectors."
        },
        "minimax.maxIterations": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "maximum": 200
        },
        "minimax.maxRetries": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 20,
          "scope": "application",
          "description": "How many times a request is repeated when the connection to MiniMax is lost. Zero turns the repeats off."
        },
        "minimax.autoApprove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Rules approved without confirmation. A tool name approves the whole tool; a scoped rule approves part of it: run_terminal(npm test) for commands starting with that prefix (chained or redirected commands never match), write_file(src/ui/) for writes inside that folder."
        },
        "minimax.mcpServers": {
          "type": "object",
          "default": {},
          "scope": "application",
          "markdownDescription": "MCP servers of the agent, the form of `mcpServers` of Claude and Cursor: `{ \"name\": { \"command\": \"npx\", \"args\": [\"-y\", \"package\"] } }` or `{ \"name\": { \"url\": \"https://...\" } }`. The servers of the plugins in `~/.minimax/plugins` start too. Every call of an MCP tool asks for approval."
        },
        "minimax.enableWebSearch": {
          "type": "boolean",
          "default": false,
          "description": "The agent searches the web with the M Plan key (the web_search tool). The queries go to MiniMax."
        },
        "minimax.rulesEnabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "minimax.addSelection",
          "when": "editorHasSelection",
          "group": "0_minimax@1"
        }
      ],
      "explorer/context": [
        {
          "command": "minimax.addFile",
          "group": "0_minimax@1"
        }
      ],
      "scm/title": [
        {
          "command": "minimax.generateCommitMessage",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "minimax.addSelection",
        "key": "ctrl+alt+m",
        "when": "editorTextFocus && editorHasSelection"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "node test/visual/serve.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "build:production": "node esbuild.mjs --production",
    "package": "node esbuild.mjs --production && vsce package",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
